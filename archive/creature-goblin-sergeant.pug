h3 #{name}
p #{family} • #{cr} • #{tier}

table
  tr
    th AC
    th HP
    th Speed
  tr
    td #{armorClass} #{armorDetails}
    td #{hitPoints}
    td #{speed}

table
  tr
    th STR
    th DEX
    th CON
    th INT
    th WIS
    th CHA
  tr
    td #{modifier(stats.str)}
    td #{modifier(stats.dex)}
    td #{modifier(stats.con)}
    td #{modifier(stats.int)}
    td #{modifier(stats.wis)}
    td #{modifier(stats.cha)}

p CR: #{cr} • XP: #{xp}

each action in actions
  h4 #{action.name}
  p #{action.desc}
