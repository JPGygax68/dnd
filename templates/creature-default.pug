.stats 
  h3 #{subtitle || name}
  p #{family} • #{cr} (#{xp} EP) • #{tier}

  table
    tr
      th Rüstungsklasse
      td #{armorClass} 
    tr
      th Trefferpunkte
      td #{hitPoints}
    tr
      th Geschwindigkeit
      td #{speed}

  div.attributes
    table
      tr
        th STÄ
        td #{stats.str}
        td #{modifier(stats.str)}
        th GEW
        td #{stats.dex}
        td #{modifier(stats.dex)}
        th KON
        td #{stats.con}
        td #{modifier(stats.con)}
      tr
        th INT
        td #{stats.int}
        td #{modifier(stats.int)}
        th WEI
        td #{stats.wis}
        td #{modifier(stats.wis)}
        th CHA
        td #{stats.cha}
        td #{modifier(stats.cha)}

  each action in actions
    h4 #{action.name}
    p #{action.desc}
